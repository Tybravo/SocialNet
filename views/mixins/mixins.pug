mixin createPostForm(userLoggedIn)
    .postFormContainer 
        .userImageContainer
            img(src=userLoggedIn.profilePic, alt="User's profile picture")
        .textareaContainer
            textarea#postTextarea(placeholder="What's going on?")
            label
                input#monetiseCheckbox(type="checkbox")
                | Monetise
            .buttonsContainer
                button#submitPostButton(disabled="") Post
